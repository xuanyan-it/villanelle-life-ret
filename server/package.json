{
  "name": "@villanelle/ret-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "prebuild": "pnpm -w --filter @villanelle/ret-shared build",
    "dev": "tsx watch src/main.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "pretypecheck": "pnpm -w --filter @villanelle/ret-shared build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}\" --max-warnings=0",
    "pretest": "pnpm -w --filter @villanelle/ret-shared build",
    "test": "vitest run -c vitest.config.ts",
    "test:coverage": "vitest run -c vitest.config.ts --coverage.enabled --coverage.provider=v8 --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reportsDirectory=../coverage/server",
    "test:e2e:mock": "vitest run -c vitest.e2e.config.ts",
    "test:e2e:real": "vitest run -c vitest.real-e2e.config.ts",
    "test:e2e": "pnpm run test:e2e:mock && pnpm run test:e2e:real",
    "verify:python-cmd": "node scripts/resolve-python-cmd.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@villanelle/ret-shared": "workspace:*",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "20.12.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.9",
    "supertest": "^7.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
