{
  "name": "@villanelle/ret-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm -w --filter @villanelle/ret-shared build",
    "build": "vite build",
    "build:electron": "vite build --mode electron --base=./",
    "preview": "vite preview",
    "pretypecheck": "pnpm -w --filter @villanelle/ret-shared build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}\" --max-warnings=0",
    "pretest": "pnpm -w --filter @villanelle/ret-shared build",
    "test": "vitest run --pool=forks --maxWorkers=1",
    "test:coverage": "vitest run --pool=forks --maxWorkers=1 --coverage.enabled --coverage.provider=v8 --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reportsDirectory=../coverage/frontend",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@ant-design/pro-components": "^2.8.10",
    "@cornerstonejs/codec-openjpeg": "1.2.3",
    "@react-pdf/renderer": "^4.3.1",
    "@reduxjs/toolkit": "^2.11.0",
    "@villanelle/ret-shared": "workspace:*",
    "antd": "^5.22.2",
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "geotiff": "^3.0.5",
    "i18next": "^25.3.4",
    "openseadragon": "4.1.1",
    "papaparse": "^5.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.5.0",
    "react-i18next": "^16.0.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.0.1",
    "web-vitals": "^2.1.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/openseadragon": "^5.0.2",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "4.0.18",
    "happy-dom": "^20.0.2",
    "jsdom": "^27.2.0",
    "lru-cache": "5.1.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.0.18"
  }
}
