{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node", "vitest/globals"],
    "noUncheckedIndexedAccess": true
  },
  "include": ["**/*.ts"],
  "exclude": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "__e2e__/**",
    "playwright.e2e.config.ts"
  ]
}

